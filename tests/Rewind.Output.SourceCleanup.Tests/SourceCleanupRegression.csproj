<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <UseSharedCompilation>false</UseSharedCompilation>
    <SourceCleanupPath Condition="'$(SourceCleanupPath)' == ''">../../src/Rewind.Output/SourceCleanup.cs</SourceCleanupPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceCleanupPath)" Link="SourceCleanup.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
    <None Include="fixtures/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
