<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rewind</AssemblyName>
    <RootNamespace>Rewind.Cli</RootNamespace>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon>..\..\assets\rewind.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rewind.Core\Rewind.Core.csproj" />
    <ProjectReference Include="..\Rewind.Analysis\Rewind.Analysis.csproj" />
    <ProjectReference Include="..\Rewind.Output\Rewind.Output.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\signatures\*.sig" Link="signatures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The licenses travel with the command too, so a standalone build has them. -->
    <None Include="..\..\LICENSE" Link="licenses\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE" Link="licenses\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="licenses\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
