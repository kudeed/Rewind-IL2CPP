<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rewind</AssemblyName>
    <RootNamespace>Rewind.Cli</RootNamespace>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rewind.Core\Rewind.Core.csproj" />
    <ProjectReference Include="..\Rewind.Analysis\Rewind.Analysis.csproj" />
    <ProjectReference Include="..\Rewind.Output\Rewind.Output.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\signatures\*.sig" Link="signatures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
