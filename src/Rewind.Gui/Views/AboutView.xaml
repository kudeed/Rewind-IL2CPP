<UserControl x:Class="Rewind.Gui.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Rewind.Gui"
             xmlns:ex="clr-namespace:Rewind.Gui.Expressive">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8,40,32,40" Width="780" HorizontalAlignment="Center">
      <Grid Width="168" Height="168" HorizontalAlignment="Center">
        <ex:ShapeView Fill="{DynamicResource M3.PrimaryContainer}" Lobes="12" Depth="0.05" TurnSeconds="45" />
        <Image Source="{DynamicResource Rewind.Logo}" Width="104" Height="104" RenderOptions.BitmapScalingMode="HighQuality" />
      </Grid>
      <TextBlock Text="Rewind" Style="{StaticResource M3.DisplayMedium}" HorizontalAlignment="Center" Margin="0,20,0,4" />
      <TextBlock Text="A decompiler for Unity games built with IL2CPP" Style="{StaticResource M3.BodyLarge}" HorizontalAlignment="Center"
                 Foreground="{DynamicResource M3.OnSurfaceVariant}" />
      <Border Background="{DynamicResource M3.SecondaryContainer}" CornerRadius="8" Padding="12,6" Margin="0,16,0,0" HorizontalAlignment="Center">
        <TextBlock Text="{Binding InstalledFrom}" Style="{StaticResource M3.LabelLarge}" Foreground="{DynamicResource M3.OnSecondaryContainer}" />
      </Border>

      <TextBlock Text="On purpose" Style="{StaticResource M3.GroupLabel}" Margin="16,32,16,8" />
      <Border CornerRadius="24" Padding="24,20" Background="{DynamicResource M3.TertiaryContainer}">
        <DockPanel>
          <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ShieldLockOutline" Width="28" Height="28" Margin="0,0,20,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource M3.OnTertiaryContainer}" />
          <StackPanel>
            <TextBlock Text="Standard IL2CPP builds only" Style="{StaticResource M3.TitleMedium}" Foreground="{DynamicResource M3.OnTertiaryContainer}" />
            <TextBlock Style="{StaticResource M3.BodyMedium}" Foreground="{DynamicResource M3.OnTertiaryContainer}" Margin="0,4,0,0"
                       Text="If a game's metadata is encrypted or modified, or the game is protected in some other way, Rewind says so and stops. It has no decryption, memory dumping or anti-cheat bypass features." />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="Links" Style="{StaticResource M3.GroupLabel}" />
      <local:ListGroup>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding RepositoryUrl}" AutomationProperties.Name="Source code">
          <DockPanel>
            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="OpenInNew" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Github" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Source code" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="{Binding RepositoryUrl}" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReadmeUrl}" AutomationProperties.Name="Read me">
          <DockPanel>
            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="OpenInNew" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="BookOpenPageVariantOutline" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Read me" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="What Rewind does, how it works and how well" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReleasesUrl}" AutomationProperties.Name="Releases">
          <DockPanel>
            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="OpenInNew" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="PackageVariant" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Releases" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="Installers for the main and experimental branches" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding LicenseUrl}" AutomationProperties.Name="License">
          <DockPanel>
            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="OpenInNew" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ScaleBalance" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="License" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="Apache License 2.0" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
      </local:ListGroup>

      <TextBlock Text="Open-source software" Style="{StaticResource M3.GroupLabel}" />
      <Border Style="{StaticResource M3.Card}">
        <TextBlock Style="{StaticResource M3.Supporting}"
                   Text="The window is built with Material Design in XAML, CommunityToolkit.Mvvm and Velopack (MIT licenses), Material Color Utilities (Apache License 2.0), and the Google Sans and Google Sans Code fonts (SIL Open Font License 1.1). The decompiler uses Mono.Cecil, ICSharpCode.Decompiler, Iced and Capstone. Their licenses are in THIRD-PARTY-NOTICES.md and the licenses folder." />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
