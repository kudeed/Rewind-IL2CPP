<UserControl x:Class="Rewind.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Rewind.Gui"
             xmlns:services="clr-namespace:Rewind.Gui.Services"
             xmlns:ex="clr-namespace:Rewind.Gui.Expressive">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8,28,32,40" MaxWidth="780" HorizontalAlignment="Center" Width="780">
      <TextBlock Text="Settings" Style="{StaticResource M3.PageTitle}" Margin="16,0,0,0" />

      <!-- ================= Updates ================= -->
      <TextBlock Text="Updates" Style="{StaticResource M3.GroupLabel}" />
      <local:ListGroup>
        <Border Style="{StaticResource M3.Row}" Padding="20,16">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource M3.TonalButton}" Command="{Binding CheckNowCommand}" AutomationProperties.Name="Check now"
                    Padding="16,0,24,0" Margin="16,0,0,0" VerticalAlignment="Center"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource M3.Icon}" ex:Motion.Spinning="{Binding IsBusy}" />
                <TextBlock Text="Check now" />
              </StackPanel>
            </Button>
            <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
              <ex:ShapeView Fill="{DynamicResource M3.TertiaryContainer}" Lobes="8" Depth="0.06" TurnSeconds="36" />
              <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource M3.OnTertiaryContainer}" />
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding InstalledFrom}" Style="{StaticResource M3.TitleMedium}" />
              <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource M3.Supporting}" />
              <ex:WavyProgress Style="{StaticResource M3.Wavy}" Value="{Binding DownloadProgress}" Maximum="100" Margin="0,10,0,0"
                               Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource M3.Row}" Visibility="{Binding ReadyToRestart, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource M3.FilledButton}" Command="{Binding RestartNowCommand}" AutomationProperties.Name="Restart now"
                    Padding="16,0,24,0" Margin="16,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Restart" Style="{StaticResource M3.Icon}" />
                <TextBlock Text="Restart now" />
              </StackPanel>
            </Button>
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="CheckCircleOutline" Style="{StaticResource M3.RowIcon}" Foreground="{DynamicResource M3.Primary}" />
            <TextBlock Text="The new version is downloaded" Style="{StaticResource M3.BodyLarge}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource M3.Row}" Visibility="{Binding CanDownload, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource M3.FilledButton}" Command="{Binding DownloadAndRestartCommand}" AutomationProperties.Name="Download and restart"
                    Padding="16,0,24,0" Margin="16,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Download" Style="{StaticResource M3.Icon}" />
                <TextBlock Text="Download and restart" />
              </StackPanel>
            </Button>
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="NewBox" Style="{StaticResource M3.RowIcon}" Foreground="{DynamicResource M3.Primary}" />
            <TextBlock Text="A new version is available" Style="{StaticResource M3.BodyLarge}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding ChooseChannelCommand}" CommandParameter="main" IsEnabled="{Binding IsInstalled}"
                AutomationProperties.Name="Update from main">
          <DockPanel>
            <RadioButton DockPanel.Dock="Left" Style="{StaticResource M3.Radio}" IsChecked="{Binding IsMainChannel, Mode=OneWay}" IsHitTestVisible="False"
                         Focusable="False" Margin="-10,0,10,0" GroupName="channel-main" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Update from main" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="Only work that passed the full test pass" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding ChooseChannelCommand}" CommandParameter="experimental" IsEnabled="{Binding IsInstalled}"
                AutomationProperties.Name="Update from experimental">
          <DockPanel>
            <RadioButton DockPanel.Dock="Left" Style="{StaticResource M3.Radio}" IsChecked="{Binding IsExperimentalChannel, Mode=OneWay}" IsHitTestVisible="False"
                         Focusable="False" Margin="-10,0,10,0" GroupName="channel-experimental" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Update from experimental" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="Every change first, tested or not. Switching installs that branch's newest build, even when it is older." Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
        <Border Style="{StaticResource M3.Row}" IsEnabled="{Binding IsInstalled}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource M3.Switch}" IsChecked="{Binding AutoUpdate}" AutomationProperties.Name="Update automatically" Margin="16,0,0,0" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Autorenew" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Update automatically" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="Looks for a new build at start and every few hours, downloads it in the background and installs it the next time Rewind starts" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Button Style="{StaticResource M3.RowButton}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReleasesUrl}"
                Visibility="{Binding IsInstalled, Converter={StaticResource Collapsed}}" AutomationProperties.Name="Get the installer">
          <DockPanel>
            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="OpenInNew" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="PackageVariant" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Get the installer" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="This copy was not installed with it, so it does not update itself" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Button>
      </local:ListGroup>

      <!-- ================= Appearance ================= -->
      <TextBlock Text="Appearance" Style="{StaticResource M3.GroupLabel}" />
      <local:ListGroup>
        <Border Style="{StaticResource M3.Row}" Padding="20,16">
          <StackPanel>
            <DockPanel>
              <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ThemeLightDark" Style="{StaticResource M3.RowIcon}" />
              <TextBlock Text="Theme" Style="{StaticResource M3.BodyLarge}" VerticalAlignment="Center" />
            </DockPanel>
            <UniformGrid Rows="1" Margin="44,12,0,0" MaxWidth="460" HorizontalAlignment="Left" Width="460">
              <RadioButton Style="{StaticResource M3.SegmentFirst}" GroupName="theme" IsChecked="{Binding IsSystemTheme}" Content="Like Windows" />
              <RadioButton Style="{StaticResource M3.Segment}" GroupName="theme" IsChecked="{Binding IsLightTheme}" Content="Light" />
              <RadioButton Style="{StaticResource M3.SegmentLast}" GroupName="theme" IsChecked="{Binding IsDarkTheme}" Content="Dark" />
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource M3.Row}" Padding="20,16">
          <StackPanel>
            <DockPanel>
              <materialDesign:PackIcon DockPanel.Dock="Left" Kind="PaletteOutline" Style="{StaticResource M3.RowIcon}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Color" Style="{StaticResource M3.BodyLarge}" />
                <TextBlock Text="Every color of the app is made from the one you pick, as on a Pixel" Style="{StaticResource M3.Supporting}" />
              </StackPanel>
            </DockPanel>
            <ListBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" Margin="36,12,0,0" Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Color">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ItemsPresenter />
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="60" Height="60" Background="Transparent" ToolTip="{Binding Label}">
                          <Ellipse x:Name="Ring" Stroke="{DynamicResource M3.Primary}" StrokeThickness="0" />
                          <Grid x:Name="Swatch" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
                            <Grid.Clip>
                              <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                            </Grid.Clip>
                            <Grid.RowDefinitions>
                              <RowDefinition />
                              <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.ColumnSpan="2" Fill="{Binding Top}" />
                            <Rectangle Grid.Row="1" Fill="{Binding Left}" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{Binding Right}" />
                          </Grid>
                          <Border x:Name="Tick" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource M3.Primary}" Visibility="Collapsed">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnPrimary}" />
                          </Border>
                          <materialDesign:PackIcon x:Name="Windows" Kind="MicrosoftWindows" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,4,4" Foreground="{DynamicResource M3.OnSurfaceVariant}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Swatch" Property="RenderTransform">
                              <Setter.Value>
                                <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                              </Setter.Value>
                            </Setter>
                          </Trigger>
                          <DataTrigger Binding="{Binding Name}" Value="{x:Static services:Accent.WindowsName}">
                            <Setter TargetName="Windows" Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </StackPanel>
        </Border>
      </local:ListGroup>

      <!-- ================= Running ================= -->
      <TextBlock Text="Running" Style="{StaticResource M3.GroupLabel}" />
      <local:ListGroup>
        <Border Style="{StaticResource M3.Row}" Padding="20,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="FolderCogOutline" Style="{StaticResource M3.RowIcon}" VerticalAlignment="Top" Margin="0,16,20,0" />
            <TextBox Grid.Column="1" Style="{StaticResource M3.Field}" Text="{Binding OutputRoot, UpdateSourceTrigger=LostFocus}"
                     materialDesign:HintAssist.Hint="Output location" materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:HintAssist.HelperText="{Binding DefaultOutputRoot, StringFormat='Each game gets a folder of its own here. Empty: {0}'}" />
            <Button Grid.Column="2" Style="{StaticResource M3.IconButton}" Command="{Binding BrowseOutputRootCommand}" ToolTip="Choose" Margin="8,10,0,0" VerticalAlignment="Top"
                    AutomationProperties.Name="Choose the output location">
              <materialDesign:PackIcon Kind="FolderOpenOutline" Width="22" Height="22" />
            </Button>
          </Grid>
        </Border>
        <Border Style="{StaticResource M3.Row}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource M3.Switch}" IsChecked="{Binding OpenOutputWhenDone}" AutomationProperties.Name="Open the output folder when a run finishes" Margin="16,0,0,0" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FolderOpenOutline" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Open the output when a run finishes" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="In File Explorer" Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource M3.Row}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource M3.Switch}" IsChecked="{Binding LowerPriority}" AutomationProperties.Name="Keep the computer responsive" Margin="16,0,0,0" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="SpeedometerSlow" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Keep the computer responsive" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Text="Runs at a lower priority while it uses every processor. The output is the same." Style="{StaticResource M3.Supporting}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </local:ListGroup>

      <!-- ================= Command line ================= -->
      <TextBlock Text="Command line" Style="{StaticResource M3.GroupLabel}" />
      <local:ListGroup>
        <Border Style="{StaticResource M3.Row}" IsEnabled="{Binding CanChangePath}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource M3.Switch}" IsChecked="{Binding OnPath}" AutomationProperties.Name="rewind on PATH" Margin="16,0,0,0" />
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ConsoleLine" Style="{StaticResource M3.RowIcon}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="rewind in every terminal" Style="{StaticResource M3.BodyLarge}" />
              <TextBlock Style="{StaticResource M3.Supporting}"
                         Text="{Binding PathFolder, StringFormat='Puts {0} on your own PATH (not the whole machine). Terminals opened afterwards can run rewind.'}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource M3.Row}" Padding="20,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="ApplicationBracesOutline" Style="{StaticResource M3.RowIcon}" VerticalAlignment="Top" Margin="0,16,20,0" />
            <TextBox Grid.Column="1" Style="{StaticResource M3.Field}" Text="{Binding CliPath, UpdateSourceTrigger=LostFocus}"
                     materialDesign:HintAssist.Hint="Use another rewind.exe" materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:HintAssist.HelperText="{Binding CliInUse}" />
            <Button Grid.Column="2" Style="{StaticResource M3.IconButton}" Command="{Binding BrowseCliCommand}" ToolTip="Choose" Margin="8,10,0,0" VerticalAlignment="Top"
                    AutomationProperties.Name="Choose rewind.exe">
              <materialDesign:PackIcon Kind="FileSearchOutline" Width="22" Height="22" />
            </Button>
          </Grid>
        </Border>
      </local:ListGroup>
    </StackPanel>
  </ScrollViewer>
</UserControl>
