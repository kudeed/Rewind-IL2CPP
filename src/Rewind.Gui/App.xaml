<Application x:Class="Rewind.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Rewind.Gui">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The toolkit gives text fields, menus, scroll bars, tooltips and the snackbar; ThemeService colors them. -->
        <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#6750A4" SecondaryColor="#6750A4" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
        <!-- Everything else is drawn here, after the Material 3 spec. -->
        <ResourceDictionary Source="Themes/M3.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:BoolToVisibility x:Key="Visible" />
      <local:BoolToVisibility x:Key="Collapsed" Invert="True" />
      <local:TextToVisibility x:Key="VisibleWithText" />
      <local:CountToVisibility x:Key="VisibleWhenAny" />
      <local:CountToVisibility x:Key="VisibleWhenNone" Invert="True" />
      <local:PageVisibility x:Key="Page" />
      <local:Not x:Key="Not" />

      <BitmapImage x:Key="Rewind.Logo" UriSource="pack://application:,,,/Assets/rewind-logo.png" DecodePixelWidth="256" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
