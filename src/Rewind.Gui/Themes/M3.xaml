<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:local="clr-namespace:Rewind.Gui"
                    xmlns:ex="clr-namespace:Rewind.Gui.Expressive">
  <!--
    Material 3 Expressive components (m3.material.io), drawn the way Android 16 draws them on a Pixel: shapes that
    morph when pressed or chosen, spring motion that overshoots and settles, connected button groups, list groups
    with big outer and small inner corners. Colors are the "M3.*" brushes ThemeService makes from one seed color.
    ex:Surface draws every control's shape; ex:Spring is the motion.
  -->

  <FontFamily x:Key="M3.Font">pack://application:,,,/Fonts/#Google Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="M3.Mono">pack://application:,,,/Fonts/#Google Sans Code, Cascadia Mono, Consolas</FontFamily>

  <ex:Spring x:Key="M3.SpringFast" Damping="0.8" />
  <ex:Spring x:Key="M3.SpringBouncy" Damping="0.45" />
  <ex:Spring x:Key="M3.SpringSoft" Damping="0.6" />

  <!-- ================= Type scale (emphasized where Expressive makes it bolder) ================= -->
  <Style x:Key="M3.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource M3.Font}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="M3.DisplayMedium" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="45" /><Setter Property="LineHeight" Value="52" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.DisplaySmall" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="36" /><Setter Property="LineHeight" Value="44" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="40" /><Setter Property="LineHeight" Value="48" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.HeadlineSmall" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="32" />
  </Style>
  <Style x:Key="M3.TitleLarge" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="22" /><Setter Property="LineHeight" Value="28" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.TitleMedium" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="24" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.TitleSmall" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.BodyLarge" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="24" />
  </Style>
  <Style x:Key="M3.BodyMedium" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="M3.BodySmall" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" />
  </Style>
  <Style x:Key="M3.LabelLarge" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.LabelMedium" TargetType="TextBlock" BasedOn="{StaticResource M3.Text}">
    <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /><Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="M3.Supporting" TargetType="TextBlock" BasedOn="{StaticResource M3.BodyMedium}">
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}" />
  </Style>
  <Style x:Key="M3.GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource M3.TitleSmall}">
    <Setter Property="Foreground" Value="{DynamicResource M3.Primary}" />
    <Setter Property="Margin" Value="20,28,16,10" />
  </Style>

  <!-- ================= Buttons: a pill that squeezes into a rounded square when pressed ================= -->
  <ControlTemplate x:Key="M3.ButtonTemplate" TargetType="ButtonBase">
    <Grid x:Name="Root">
      <ex:Surface x:Name="Shape" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"
                  Overlay="{TemplateBinding Foreground}" FocusRing="{DynamicResource M3.Secondary}"
                  CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}" PressedRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="Center" RecognizesAccessKey="True" />
      </ex:Surface>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard><DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="OverlayOpacity" To="0.08" Duration="0:0:0.12" /></Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard><DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="OverlayOpacity" Duration="0:0:0.2" /></Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Squeeze" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource M3.SpringFast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Squeeze" Duration="0:0:0.65" EasingFunction="{StaticResource M3.SpringBouncy}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Shape" Property="FocusOpacity" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.38" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="M3.Button" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{StaticResource M3.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
    <!-- The corner radius when pressed -->
    <Setter Property="Tag" Value="8" />
    <Setter Property="Template" Value="{StaticResource M3.ButtonTemplate}" />
  </Style>
  <Style x:Key="M3.FilledButton" TargetType="ButtonBase" BasedOn="{StaticResource M3.Button}">
    <Setter Property="Background" Value="{DynamicResource M3.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnPrimary}" />
  </Style>
  <Style x:Key="M3.TonalButton" TargetType="ButtonBase" BasedOn="{StaticResource M3.Button}">
    <Setter Property="Background" Value="{DynamicResource M3.SecondaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSecondaryContainer}" />
  </Style>
  <Style x:Key="M3.OutlinedButton" TargetType="ButtonBase" BasedOn="{StaticResource M3.Button}">
    <Setter Property="BorderBrush" Value="{DynamicResource M3.OutlineVariant}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}" />
  </Style>
  <Style x:Key="M3.TextButton" TargetType="ButtonBase" BasedOn="{StaticResource M3.Button}">
    <Setter Property="Foreground" Value="{DynamicResource M3.Primary}" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <!-- Floating action button, medium size: a rounded square that turns round when pressed -->
  <Style x:Key="M3.Fab" TargetType="ButtonBase" BasedOn="{StaticResource M3.Button}">
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="24,0,28,0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
    <Setter Property="Tag" Value="32" />
    <Setter Property="Background" Value="{DynamicResource M3.PrimaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnPrimaryContainer}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.2" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="M3.IconButton" TargetType="ButtonBase" BasedOn="{StaticResource M3.Button}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Tag" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}" />
  </Style>
  <Style x:Key="M3.TonalIconButton" TargetType="ButtonBase" BasedOn="{StaticResource M3.IconButton}">
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerHighest}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}" />
  </Style>
  <Style x:Key="M3.Icon" TargetType="materialDesign:PackIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- ================= Connected button group: the chosen button rounds into a pill ================= -->
  <Style x:Key="M3.Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource M3.Font}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource M3.SurfaceContainerHighest}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}" />
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root">
            <ex:Surface x:Name="Shape" Fill="{TemplateBinding Background}" Overlay="{TemplateBinding Foreground}" FocusRing="{DynamicResource M3.Secondary}"
                        CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}" PressedRadius="4">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                <materialDesign:PackIcon x:Name="Check" Kind="Check" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                  <materialDesign:PackIcon.RenderTransform>
                    <ScaleTransform ScaleX="0" ScaleY="0" />
                  </materialDesign:PackIcon.RenderTransform>
                </materialDesign:PackIcon>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </ex:Surface>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="{DynamicResource M3.Primary}" />
              <Setter Property="Foreground" Value="{DynamicResource M3.OnPrimary}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Round" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringBouncy}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Round" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringSoft}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="OverlayOpacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Squeeze" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource M3.SpringFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Squeeze" Duration="0:0:0.6" EasingFunction="{StaticResource M3.SpringBouncy}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Shape" Property="FocusOpacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="M3.SegmentFirst" TargetType="RadioButton" BasedOn="{StaticResource M3.Segment}">
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="24,8,8,24" />
  </Style>
  <Style x:Key="M3.SegmentLast" TargetType="RadioButton" BasedOn="{StaticResource M3.Segment}">
    <Setter Property="Margin" Value="1,0,0,0" />
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8,24,24,8" />
  </Style>

  <!-- ================= Switch: the thumb springs across and grows ================= -->
  <Style x:Key="M3.Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root" Width="52" Height="32" Background="Transparent">
            <Border x:Name="Track" CornerRadius="16" Background="{DynamicResource M3.SurfaceContainerHighest}"
                    BorderBrush="{DynamicResource M3.Outline}" BorderThickness="2" />
            <Grid x:Name="Knob" Width="40" Height="40" HorizontalAlignment="Left" Margin="-4,-4,0,-4">
              <Grid.RenderTransform>
                <TranslateTransform X="0" />
              </Grid.RenderTransform>
              <Ellipse x:Name="Halo" Fill="{DynamicResource M3.OnSurface}" Opacity="0" />
              <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource M3.Outline}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <materialDesign:PackIcon x:Name="Tick" Kind="Check" Width="16" Height="16" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnPrimaryContainer}" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource M3.Primary}" />
              <Setter TargetName="Track" Property="BorderThickness" Value="0" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource M3.OnPrimary}" />
              <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource M3.Primary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.55" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.5" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.5" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.08" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.55" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource M3.SpringSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource M3.SpringSoft}" />
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.08" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource M3.OnSurfaceVariant}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Radio button and check box ================= -->
  <Style x:Key="M3.Radio" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Width="40" Height="40" Background="Transparent">
            <Ellipse x:Name="Halo" Fill="{DynamicResource M3.OnSurface}" Opacity="0" />
            <Ellipse x:Name="Ring" Width="20" Height="20" Stroke="{DynamicResource M3.OnSurfaceVariant}" StrokeThickness="2" />
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource M3.Primary}" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="0" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource M3.Primary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource M3.SpringBouncy}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="M3.CheckBox" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurface}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40">
              <Ellipse x:Name="Halo" Fill="{DynamicResource M3.OnSurface}" Opacity="0" />
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" BorderThickness="2" BorderBrush="{DynamicResource M3.OnSurfaceVariant}" />
              <materialDesign:PackIcon x:Name="Tick" Kind="CheckBold" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource M3.OnPrimary}" RenderTransformOrigin="0.5,0.5">
                <materialDesign:PackIcon.RenderTransform>
                  <ScaleTransform ScaleX="0" ScaleY="0" />
                </materialDesign:PackIcon.RenderTransform>
              </materialDesign:PackIcon>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource M3.Primary}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource M3.Primary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource M3.SpringBouncy}" />
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource M3.SpringBouncy}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="Opacity" Value="0.08" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Navigation rail: the pill springs open, the icon spins or pops (Motion.NavItem) ================= -->
  <Style x:Key="M3.NavItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ex:Motion.NavItem" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <StackPanel Background="Transparent" Margin="0,0,0,16">
            <Grid Width="64" Height="36" HorizontalAlignment="Center">
              <ex:Surface x:Name="Pill" Fill="{DynamicResource M3.SecondaryContainer}" Round="1" Opacity="0" />
              <ex:Surface x:Name="Hover" Fill="{DynamicResource M3.OnSurface}" Round="1" Opacity="0" />
              <materialDesign:PackIcon x:Name="Icon" Kind="{Binding Icon}" Width="24" Height="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
            </Grid>
            <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource M3.LabelMedium}" TextWrapping="NoWrap"
                       HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Icon" Property="Kind" Value="{Binding SelectedIcon}" />
              <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource M3.OnSecondaryContainer}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource M3.OnSurface}" />
              <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="M3.NavRail" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource M3.NavItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= List rows (ListGroup shapes their corners) ================= -->
  <Style x:Key="M3.Row" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource M3.RowBrush}" />
    <Setter Property="Padding" Value="20,14,16,14" />
    <Setter Property="MinHeight" Value="68" />
  </Style>
  <!-- A row that does something when clicked: its inner corners round out while it is pressed -->
  <Style x:Key="M3.RowButton" TargetType="ButtonBase">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurface}" />
    <Setter Property="Background" Value="{DynamicResource M3.RowBrush}" />
    <Setter Property="Padding" Value="20,14,16,14" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Tag" Value="24" />
    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Grid x:Name="Root">
            <ex:Surface x:Name="Shape" Fill="{TemplateBinding Background}" Overlay="{DynamicResource M3.OnSurface}" FocusRing="{DynamicResource M3.Secondary}"
                        CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}" PressedRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </ex:Surface>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="OverlayOpacity" Value="0.05" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Squeeze" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource M3.SpringFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shape" Storyboard.TargetProperty="Squeeze" Duration="0:0:0.7" EasingFunction="{StaticResource M3.SpringBouncy}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Shape" Property="FocusOpacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.38" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="M3.RowIcon" TargetType="materialDesign:PackIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource M3.OnSurfaceVariant}" />
  </Style>

  <!-- ================= Cards ================= -->
  <Style x:Key="M3.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource M3.RowBrush}" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="24,20" />
  </Style>

  <!-- ================= Text fields and menus: the toolkit's outlined field, which is the M3 one ================= -->
  <Style x:Key="M3.Field" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
    <Setter Property="FontFamily" Value="{StaticResource M3.Font}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Margin" Value="0,6,0,2" />
    <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12" />
    <Setter Property="materialDesign:HintAssist.Background" Value="{DynamicResource M3.RowBrush}" />
  </Style>
  <Style x:Key="M3.Combo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
    <Setter Property="FontFamily" Value="{StaticResource M3.Font}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12" />
    <Setter Property="materialDesign:HintAssist.Background" Value="{DynamicResource M3.RowBrush}" />
  </Style>

  <!-- ================= Wavy progress ================= -->
  <Style x:Key="M3.Wavy" TargetType="ex:WavyProgress">
    <Setter Property="Active" Value="{DynamicResource M3.Primary}" />
    <Setter Property="Track" Value="{DynamicResource M3.SecondaryContainer}" />
  </Style>

  <!-- ================= Thin scroll bars: a rounded thumb that darkens under the mouse ================= -->
  <Style x:Key="M3.ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="M3.ScrollThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="3" Margin="3" Background="{DynamicResource M3.OnSurfaceVariant}" Opacity="0.3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource M3.ScrollPage}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource M3.ScrollThumb}" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource M3.ScrollPage}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource M3.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource M3.ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource M3.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ================= Plain list (assemblies, output lines) ================= -->
  <Style x:Key="M3.PlainItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="12,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource M3.SecondaryContainer}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
